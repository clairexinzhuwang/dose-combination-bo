    "required_state_checks": ["gate pass set always", "eligible gate pass set always", "full fallback index when full gate is empty", "eligible fallback index when eligible gate is empty", "terminal state", "saved terminal recommendation index when recommendation_made=true; explicit not-applicable marker when stopped"],
